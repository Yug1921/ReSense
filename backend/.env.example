# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Claude (optional, paid): when set, Claude Haiku writes summaries and answers,
# and the free providers below are only a backup. Key from console.anthropic.com.
ANTHROPIC_API_KEY=

# OpenRouter (free LLM provider)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=your-free-model-slug
OPENROUTER_FALLBACK_MODELS=fallback-model-1,fallback-model-2
OPENROUTER_VISION_MODEL=
OPENROUTER_VISION_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional fallback providers (variable names are case-sensitive)
Groq=
Gemini=

# App
MAX_UPLOAD_MB=20
ALLOWED_ORIGINS=http://localhost:3000

# Reference verification: email for Crossref's polite pool
CROSSREF_MAILTO=

# Reference verification: free OpenAlex API key (https://openalex.org/settings/api).
# Without it OpenAlex allows only a tiny anonymous daily quota.
OPENALEX_API_KEY=
