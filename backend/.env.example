# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Free AI providers. Add any or all three keys; ReSense picks the best free
# models each key can use and falls back from one to the next.
# Check them with:  python -m app.check_ai
# (Gemini and Groq: variable names are case-sensitive.)
Gemini=
Groq=
OPENROUTER_API_KEY=

# Optional: models to try first, comma-separated. Leave empty for automatic.
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_VISION_MODEL=
OPENROUTER_VISION_FALLBACK_MODELS=

# App
MAX_UPLOAD_MB=20
ALLOWED_ORIGINS=http://localhost:3000

# Reference verification: email for Crossref's polite pool
CROSSREF_MAILTO=

# Reference verification: free OpenAlex API key (https://openalex.org/settings/api).
# Without it OpenAlex allows only a tiny anonymous daily quota.
OPENALEX_API_KEY=
